# Testcase categories shown in the UI (comma-separated)
APP_CATEGORIES=X,Y,Z

# Path to the SQLite database file (optional — defaults to app.db next to main.py)
# Absolute paths are recommended. The directory is created automatically if it does not exist.
# APP_DB=W:\bugula-db\prod.db

# Database engine and connection. Managed automatically by Settings > Database
# in the app (Save writes these keys back into this file) — set by hand only
# for first-time setup or headless deployments.
# DB_ENGINE=sqlite
# DB_SQLITE_PATH=
# DB_PG_HOST=
# DB_PG_PORT=5432
# DB_PG_DBNAME=
# DB_PG_USER=
# DB_PG_PASSWORD=